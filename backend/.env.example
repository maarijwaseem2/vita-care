# ===========================================================================
# Vita Care Backend — Environment Variables
# Copy this file to ".env" and fill in your own values.
# ===========================================================================

# --- Application ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS).
# In production set this to your Vercel URL, e.g. https://vita-care.vercel.app
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL Database ---
# Option 1 (recommended for Neon / Render): a single connection string.
# Neon gives you something like:
#   postgresql://user:password@ep-xxx-123.eu-central-1.aws.neon.tech/vita_care?sslmode=require
# When DATABASE_URL is set, SSL is turned on automatically and the DB_* vars below are ignored.
# DATABASE_URL=

# Option 2 (handy for local development): individual parts.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=vita_care
# Set to "true" if your local Postgres also needs SSL (Neon does this for you via DATABASE_URL).
DB_SSL=false
# Never enable "synchronize" in production — we use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT Auth ---
# Generate a long random value, e.g.  openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- AI Doctor (Chatbot) ---
# The chatbot talks to any OpenAI-compatible Chat Completions API.
# Put YOUR key here — it is only read on the server, never sent to the browser.
AI_API_KEY=sk-your-api-key-here
# Base URL of the provider (default = OpenAI).
AI_BASE_URL=https://api.openai.com/v1
# Model name to use.
AI_MODEL=gpt-4o-mini
