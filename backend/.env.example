# ===========================================================================
# Vita Care Backend — Environment Variables
# Copy this file to ".env" and fill in your own values.
# ===========================================================================

# --- Application ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS).
# In production set this to your Vercel URL, e.g. https://vita-care.vercel.app
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL Database ---
# Option 1 (recommended for Neon / Render): a single connection string.
# Neon gives you something like:
#   postgresql://user:password@ep-xxx-123.eu-central-1.aws.neon.tech/vita_care?sslmode=require
# When DATABASE_URL is set, SSL is turned on automatically and the DB_* vars below are ignored.
# DATABASE_URL=

# Option 2 (handy for local development): individual parts.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=vita_care
# Set to "true" if your local Postgres also needs SSL (Neon does this for you via DATABASE_URL).
DB_SSL=false
# Never enable "synchronize" in production — we use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT Auth ---
# Generate a long random value, e.g.  openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
# Admin sessions expire sooner.
JWT_ADMIN_EXPIRES_IN=12h
# Behind a hosting proxy (Render/Vercel/Nginx): number of proxies in front of the API.
# Defaults to 1 in production so rate limits use each visitor's real IP.
TRUST_PROXY=1

# --- AI Doctor (chat model) ---
# Any OpenAI-compatible provider. Leave AI_API_KEY empty to run the AI Doctor
# in OFFLINE rule-based mode (the safety guard still works).
#
# Option A: OpenAI
#   AI_API_KEY=sk-...        AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini     AI_VISION_MODEL=gpt-4o-mini
# Option B: Alibaba Cloud Model Studio (Qwen)
#   AI_API_KEY=sk-...        AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-plus       AI_VISION_MODEL=qwen-vl-max
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# --- Voice (speech-to-text + Urdu text-to-speech) ---
# Uses the OpenAI audio API. If AI_* above already points to OpenAI, the same
# key is reused and you can leave OPENAI_API_KEY empty. Qwen's speech models do
# not list Urdu, so voice stays on OpenAI even when chat uses Qwen.
# Without a key the site falls back to the browser's own speech features.
OPENAI_API_KEY=

# --- AI usage limits (per signed-in user, per day, reset at midnight Pakistan time) ---
# The AI Doctor, report reader and voice need a login. Admin accounts are unlimited.
AI_DAILY_MESSAGES=40
AI_DAILY_REPORTS=5
AI_DAILY_VOICE=40
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral

# --- Uploads (blog images, doctor photos) ---
# Local default: ./uploads. On Render free tier leave this UNSET (uses ./uploads).
# Only set this if you attached a persistent disk, e.g. mount path /var/data:
# UPLOAD_DIR=/var/data/uploads

# --- Email verification (Brevo, free: 300 emails/day) ---
# brevo.com → SMTP & API → API Keys → "Generate a new API key"
BREVO_API_KEY=
# A sender you verified in Brevo (Senders, Domains & Dedicated IPs → Senders)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Vita Care
# The website address used in the email link (no trailing slash), e.g. https://vitacare.example.com
APP_URL=http://localhost:3000

# --- Google sign-in (Firebase Authentication, free up to 50,000 users/month) ---
# Firebase console → Project settings → General → "Project ID"
FIREBASE_PROJECT_ID=

# --- Contact page: new messages are emailed here (and shown in Admin → Messages) ---
SUPPORT_EMAIL=maarijwaseem7@gmail.com
