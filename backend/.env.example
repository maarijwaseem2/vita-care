# ===========================================================================
# Vita Care Backend — Environment Variables
# Copy this file to ".env" and fill in your own values.
# ===========================================================================

# --- Application ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS).
# In production set this to your Vercel URL, e.g. https://vita-care.vercel.app
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL Database ---
# Option 1 (recommended for Neon / Render): a single connection string.
# Neon gives you something like:
#   postgresql://user:password@ep-xxx-123.eu-central-1.aws.neon.tech/vita_care?sslmode=require
# When DATABASE_URL is set, SSL is turned on automatically and the DB_* vars below are ignored.
# DATABASE_URL=

# Option 2 (handy for local development): individual parts.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=vita_care
# Set to "true" if your local Postgres also needs SSL (Neon does this for you via DATABASE_URL).
DB_SSL=false
# Never enable "synchronize" in production — we use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT Auth ---
# Generate a long random value, e.g.  openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# --- AI Doctor (chat model) ---
# Any OpenAI-compatible provider. Leave AI_API_KEY empty to run the AI Doctor
# in OFFLINE rule-based mode (the safety guard still works).
#
# Option A: OpenAI
#   AI_API_KEY=sk-...        AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini     AI_VISION_MODEL=gpt-4o-mini
# Option B: Alibaba Cloud Model Studio (Qwen)
#   AI_API_KEY=sk-...        AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-plus       AI_VISION_MODEL=qwen-vl-max
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# --- Voice (speech-to-text + Urdu text-to-speech) ---
# Uses the OpenAI audio API. If AI_* above already points to OpenAI, the same
# key is reused and you can leave OPENAI_API_KEY empty. Qwen's speech models do
# not list Urdu, so voice stays on OpenAI even when chat uses Qwen.
# Without a key the site falls back to the browser's own speech features.
OPENAI_API_KEY=
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral

# --- Uploads (blog images) ---
# Folder for uploaded images, served at /uploads. Use a persistent disk in production.
# UPLOAD_DIR=/var/data/uploads
