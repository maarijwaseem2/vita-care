# ===========================================================================
# Vita Care Frontend — Environment Variables
# Copy this file to ".env.local".
# ===========================================================================

# Public URL of the NestJS API (note the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this website (used for canonical links, Open Graph and SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: faster private URL the Next.js server uses for server-rendered pages (blog).
# API_INTERNAL_URL=http://localhost:4000/api

# --- Google sign-in (Firebase Authentication) ---
# Firebase console → Project settings → General → "Your apps" → Web app → SDK setup and configuration (Config)
# Leave empty to hide the "Continue with Google" button.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
